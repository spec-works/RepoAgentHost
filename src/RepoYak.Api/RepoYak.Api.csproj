<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>repoyak</AssemblyName>
    <Version>0.2.0-preview.4</Version>
    <Product>RepoYak</Product>
    <Description>RepoYak by Spec-Works turns local Git repositories into A2A agents with AI Catalog discovery.</Description>
    <RepositoryUrl>https://github.com/spec-works/RepoYak</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackAsTool>true</PackAsTool>
    <IsPackable>true</IsPackable>
    <ToolCommandName>repoyak</ToolCommandName>
    <PackageId>SpecWorks.RepoYak.Cli</PackageId>
    <Authors>Darrel Miller</Authors>
    <PackageProjectUrl>https://github.com/spec-works/RepoYak</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <PackageTags>repoyak;spec-works;a2a;ai-catalog;agents;copilot</PackageTags>
    <RuntimeIdentifiers>win-x64;win-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <PublishSelfContained>true</PublishSelfContained>
    <PackageOutputPath>$(MSBuildProjectDirectory)\..\..\artifacts\packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <PackageReference Include="A2A.AspNetCore" Version="1.0.0-preview3" />
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.28" />
    <Content Include="..\..\skills\repoyak-cli\SKILL.md"
             Pack="false"
             Link="skills\repoyak-cli\SKILL.md"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
    <Content Include="..\..\plugin.json" Link="plugin.json"
             Pack="false"
             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\LICENSE" Link="LICENSE"
             Pack="false"
             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\specs.json" Link="specs.json"
             Pack="false"
             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
